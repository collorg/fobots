# /etc/systemd/system/fobots.service
#
# Installation: sudo ./fobots.py install   (creates the user, the directories, the configuration
# and this unit, with the log access group). Manually:
#   useradd --system --no-create-home --shell /usr/sbin/nologin fobots
#   install -d /opt/fobots && cp -r fobots.py fobots /opt/fobots/   # launcher + package
#   install -D -m 0644 fobots.conf.example /etc/fobots/fobots.conf   # then edit it
#   systemctl daemon-reload && systemctl enable --now fobots
#
# Files: configuration and welcome list in /etc/fobots/, state in /var/lib/fobots/ (see README).
# Administration commands: as ROOT (sudo), since they read/modify nft and /etc/fobots.
# Follow: journalctl -u fobots -f        Active bans: sudo /opt/fobots/fobots.py bans
# Welcome list (also removes the bans):
#   sudo /opt/fobots/fobots.py welcome add 17.0.0.0/8
# Most active ranges: systemctl kill -s USR1 fobots   (then journalctl)

[Unit]
Description=fobots - bannissement nftables des plages d'IP trop agressives
After=network-online.target nftables.service
Wants=network-online.target
# A restart/reload of nftables.service ("flush ruleset") erases the inet fobots table
# and all the bans: we follow its restarts and recreate the table when it reloads.
PartOf=nftables.service
ReloadPropagatedFrom=nftables.service

[Service]
Type=simple
User=fobots
# The log must be readable by this user: adapt the group (adm, root, gitlab-www…)
# or grant access with setfacl. Check: sudo -u fobots head -1 /var/log/gitlab/nginx/gitlab_access.log
SupplementaryGroups=adm
ConfigurationDirectory=fobots
StateDirectory=fobots

# `setup` is idempotent: creates the nft table if missing, otherwise does nothing.
ExecStartPre=/opt/fobots/fobots.py setup -f /etc/fobots/fobots.conf
ExecStart=/opt/fobots/fobots.py run -f /etc/fobots/fobots.conf
ExecReload=/opt/fobots/fobots.py setup -f /etc/fobots/fobots.conf
Restart=on-failure
RestartSec=5

# nft only needs CAP_NET_ADMIN; there is no need to be root.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes

# Hardening (to relax if a particular case requires it).
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
