# fobots.conf: looked up in /etc/fobots/ then in the current directory (or -f FILE).
# Relative paths are relative to this file. The command line overrides it.
[fobots]
# Log to follow continuously (rotation handled). Without this option: stdin.
log = /var/log/gitlab/nginx/gitlab_access.log
# State directory (created if missing): RDAP cache and monitoring findings.
# dir = /var/lib/fobots
# cache = ip_ranges.json        # RDAP ranges found (default: <dir>/ip_ranges.json)
# The welcome list is welcome.txt next to this file (so /etc/fobots/welcome.txt);
# to change it:
# welcome = /etc/fobots/welcome.txt

threshold = 5        # req/s of a range above which it is banned
# prefix_threshold = 5 # req/s of an unresolved /16 that trigger an RDAP request
sustain = 5          # consecutive seconds above the threshold required (a page load is a short burst)
window = 60          # window (s) over which the IPs seen are tracked
ban_time = 1h        # duration of a ban: 30m, 1h, 1d…

# Load-based hardening (disabled by default).
# At the "tense" / "critical" level, the threshold AND the ban duration are multiplied by
# the factor: bans are stricter but shorter, and ranges are re-judged sooner.
# load_signal = none   # none | probe (response time of the service) | psi (/proc/pressure) | loadavg
# probe: one GET every 5 s on a typical DYNAMIC page (must answer 2xx), from the machine itself;
# levels in seconds (defaults 1 and 3). Measure first: `fobots probe --url …`
# load_probe_url = www.example.org@http://127.0.0.1/app/some-dynamic-page
# load_probe_timeout = 10s
# load_tense = 20      # signal value for the tense level (probe: 1 s; psi: %; loadavg: per core)
# load_critical = 50   # same for critical (probe: 3 s; loadavg defaults: 1.0 and 2.0)
# load_recover = 5m    # time below the level before going down one level
# tense_factor = 0.5
# critical_factor = 0.25
# min_threshold = 1    # floor of the effective threshold (req/s)
# min_ban_time = 1m    # floor of the effective ban duration

# One log per virtual host: one [site:NAME] section per target, with its own exclusion
# rules (in addition to ignore_path below). A host with several names (CNAME) has a single
# section: its log is unique. The log of [fobots] and those of the sites must differ;
# to use sections only, remove the `log =` line of [fobots].
# [site:gitlab]
# log = /var/log/gitlab/nginx/gitlab_access.log
# ignore_path = ^/(assets/|favicon\.ico|robots\.txt)
# [site:showcase]
# log = /var/log/nginx/showcase.access.log
# ignore_all = yes

# Cheap static pages not to count (regex on the request path). Anchor on prefixes of static
# directories, NOT on extensions (\.js, \.css would also exempt the repository files served by
# GitLab, which are dynamic and expensive). This is not an authorisation: a banned range is
# dropped by the firewall before nginx, static pages included.
# ignore_path = ^/(assets/|favicon|robots\.txt)

# Opt-in monitoring: these requests are counted like the others (no exemption), but when their
# range is banned, the journal says (WATCH) which IPs matched and gives the `welcome add`
# command to protect them. Regular expressions; if both are given, both must match.
# The route belongs to a host: put them in its [site:NAME] section (they replace these
# global values for that target):
#   [site:gitlab]
#   watch_agent = ^gitlab-runner
#   watch_path = ^/api/v4/
# watch_agent = ^gitlab-runner
# watch_path = ^/api/v4/
# watch_file = watched.jsonl   # findings recorded (default: <dir>/watched.jsonl), reread by
#                              `fobots watched`; pruned beyond 30 days at startup

# Trap paths (learning only, nothing is banned): a path that gets a 404/403 and is asked for by
# many distinct IPs from different networks is a scanner's target. What the site really serves
# (2xx/3xx) protects: an exact path that answered, or a path of the same shape (/post/{uuid},
# {int}, {ulid}, {hex}, {slug}) once served with trap_template_min different values.
# `fobots traps` lists the traps and the shapes learned (from the daemon's snapshot, or from logs).
# traps = no
# trap_min_ips = 5        # distinct IPs asking for the same missing path
# trap_min_nets = 3       # ... from at least this many /16 networks
# trap_window = 6h        # period over which the IPs are counted
# trap_template_min = 3   # values served before a shape protects a missing path
# traps_file = traps.json # snapshot (default: <dir>/traps.json)

# Tight bans: instead of banning the whole RDAP allocation, ban the groups of IPs seen inside
# it; fall back to wide blocks if the traffic is scattered or after several partial bans.
# Slow scrapers: a range that stays at about one request per second for hours never exceeds
# `threshold`. This bans a range whose AVERAGE rate over slow_window exceeds slow_threshold
# (req/s); 0 = disabled. Measure it first: `fobots analyse` (table "Slow scrapers").
# slow_threshold = 0.5
# slow_window = 10m

# ban_scope = allocation   # allocation | observed (try it with --dry-run first)
# observed_prefix = 20     # maximum extent of a group (IPv4 prefix; IPv6: /48)
# observed_escalate = 4    # partial bans of an allocation before falling back to wide blocks
# observed_max_prefix = 16 # fallback (scattered traffic): /16 blocks instead of the allocation; 0 = whole allocation

rdap_per_hour = 100  # budget of RDAP requests
delay = 2            # minimum seconds between two RDAP requests
# nft_bin = nft
# from_start = no      # first read the existing content of the log
