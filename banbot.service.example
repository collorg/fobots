# /etc/systemd/system/banbot.service
#
# Installation (à adapter) :
#   useradd --system --no-create-home --shell /usr/sbin/nologin banbot
#   install -m 0755 banbot.py /opt/banbot/banbot.py
#   install -D -m 0644 banbot.conf.example /etc/banbot/banbot.conf   # puis l'éditer
#   systemctl daemon-reload && systemctl enable --now banbot
#
# Fichiers : conf et liste blanche dans /etc/banbot/, état dans /var/lib/banbot/ (voir README).
# Commandes d'administration : en ROOT (sudo), car elles lisent/modifient nft et /etc/banbot.
# Suivi : journalctl -u banbot -f        Bans actifs : sudo /opt/banbot/banbot.py bans
# Liste blanche (retire aussi les bans) :
#   sudo /opt/banbot/banbot.py whitelist add 17.0.0.0/8
# Plages les plus actives : systemctl kill -s USR1 banbot   (puis journalctl)

[Unit]
Description=banbot - bannissement nftables des plages d'IP trop agressives
After=network-online.target nftables.service
Wants=network-online.target
# Un restart/reload de nftables.service (« flush ruleset ») efface la table inet banbot
# et tous les bans : on suit ses redémarrages et on recrée la table à son rechargement.
PartOf=nftables.service
ReloadPropagatedFrom=nftables.service

[Service]
Type=simple
User=banbot
# Le log doit être lisible par cet utilisateur : adapter le groupe (adm, root, gitlab-www…)
# ou donner l'accès avec setfacl. Vérifier : sudo -u banbot head -1 /var/log/gitlab/nginx/gitlab_access.log
SupplementaryGroups=adm
ConfigurationDirectory=banbot
StateDirectory=banbot

# `setup` est idempotent : crée la table nft si elle manque, sinon ne fait rien.
ExecStartPre=/opt/banbot/banbot.py setup -f /etc/banbot/banbot.conf
ExecStart=/opt/banbot/banbot.py run -f /etc/banbot/banbot.conf
ExecReload=/opt/banbot/banbot.py setup -f /etc/banbot/banbot.conf
Restart=on-failure
RestartSec=5

# nft n'a besoin que de CAP_NET_ADMIN ; pas besoin d'être root.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes

# Durcissement (à assouplir si un cas particulier l'exige).
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
